GEMINI_API_KEY=
# Leave empty on the first run to create a store; persist the printed value afterward.
GEMINI_FILE_SEARCH_STORE=
GEMINI_STORE_DISPLAY_NAME=optisigns-support
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-2
GEMINI_MODEL=gemini-2.5-flash

SUPPORT_API_URL=https://support.optisigns.com/api/v2/help_center/en-us/articles.json
MIN_ARTICLES=30
# Maximum number of unique articles to scrape per run.
MAX_ARTICLES=35
REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3
CHUNK_MAX_TOKENS=400
CHUNK_OVERLAP_TOKENS=40
GEMINI_POLL_SECONDS=5
GEMINI_POLL_TIMEOUT_SECONDS=600
